generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CardCondition {
  MINT
  NEAR_MINT
  EXCELLENT
  GOOD
  PLAYED
  POOR
}

model Card {
  id         String         @id @default(uuid())
  name       String
  setName    String
  cardNumber String?
  rarity     String?
  condition  CardCondition  @default(NEAR_MINT)
  quantity   Int            @default(1)
  notes      String?
  imageKey   String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  identifyCandidates Json?

  @@map("cards")
}